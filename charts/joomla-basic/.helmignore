# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/

# Codex instructions; version-controlled but not part of the Helm chart
/AGENTS.md

# Development notes; omit this if joomla-basic.md should be packaged
/joomla-basic.md

# The ignore file itself is not needed in the packaged chart
/.helmignore